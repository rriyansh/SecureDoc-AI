# EditorConfig for SecureDoc AI
root = true

[*]
indent_style = space
indent_size = 4
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.{py,pyx,pxd,pxi}]
indent_size = 4

[*.{yml,yaml}]
indent_size = 2

[*.{json,toml,ini,cfg}]
indent_size = 2

[Makefile]
indent_style = tab