# ============================================
# SecureDoc AI v3 — Environment
# ============================================

# --- OpenAI ---
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_FALLBACK_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- App ---
APP_NAME=SecureDoc AI
APP_VERSION=3.0.0
ENVIRONMENT=production
LOG_LEVEL=INFO
LOG_FORMAT=json
DEBUG=false

# --- Auth ---
API_KEYS=replace-with-hex-32,replace-with-hex-32
JWT_SECRET=replace-with-hex-32-at-least-32-chars-long
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
JWT_ISSUER=securedoc-ai
ADMIN_API_KEY=replace-with-hex-32

# --- Request signing (optional, defense-in-depth) ---
REQUEST_SIGNING_ENABLED=false
REQUEST_SIGNING_SECRET=replace-with-hex-32
REQUEST_SIGNING_WINDOW_SECONDS=300

# --- Crypto (for encrypted cache) ---
CACHE_ENCRYPTION_KEY=replace-with-hex-32-at-least-32-chars-long

# --- Paths ---
VECTORSTORE_PATH=./vectorstore
DOCSTORE_PATH=./docstore
DOCUMENTS_PATH=./documents
CONFIG_PATH=./config
AUDIT_PATH=./audit

# --- Retrieval ---
CHILD_CHUNK_SIZE=400
CHILD_CHUNK_OVERLAP=50
PARENT_CHUNK_SIZE=2000
PARENT_CHUNK_OVERLAP=200
RETRIEVER_TOP_K=10
RERANK_TOP_K=4
BM25_WEIGHT=0.4
VECTOR_WEIGHT=0.6
ENABLE_RERANKER=true
ENABLE_QUERY_REWRITE=true
RETRIEVER_TIMEOUT_SECONDS=15

# --- Cache ---
CACHE_ENABLED=true
CACHE_TTL_SECONDS=3600
CACHE_MAX_SIZE=1000
CACHE_ENCRYPT=true

# --- Rate limit ---
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_BURST=10
RATE_LIMIT_STRATEGY=token_bucket

# --- Anomaly detection ---
ANOMALY_DETECTION_ENABLED=true
ANOMALY_THRESHOLD=20
ANOMALY_WINDOW_SECONDS=10

# --- Circuit breaker ---
CIRCUIT_BREAKER_ENABLED=true
CIRCUIT_BREAKER_FAIL_MAX=5
CIRCUIT_BREAKER_RESET_SECONDS=60
CIRCUIT_BREAKER_HALF_OPEN_MAX=2

# --- Deduplication ---
DEDUP_ENABLED=true
DEDUP_WINDOW_SECONDS=30

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
API_CORS_ORIGINS=http://localhost:3000
API_MAX_REQUEST_SIZE_MB=10
SECURITY_HEADERS_ENABLED=true
SECURITY_IP_ALLOWLIST=

# --- Audit ---
AUDIT_ENABLED=true
AUDIT_MAX_PAYLOAD_CHARS=500
AUDIT_CHAIN_HASH=true

# --- Metrics ---
METRICS_ENABLED=true
