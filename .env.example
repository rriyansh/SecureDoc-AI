# OpenAI
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# App
APP_NAME=SecureDoc AI
APP_VERSION=2.0.0
LOG_LEVEL=INFO
ENVIRONMENT=production
DEBUG=false

# Auth
API_KEYS=replace-with-hex-32,replace-with-hex-32
JWT_SECRET=replace-with-hex-32-at-least-32-chars-long
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
ADMIN_API_KEY=replace-with-hex-32

# Paths
VECTORSTORE_PATH=./vectorstore
DOCSTORE_PATH=./docstore
DOCUMENTS_PATH=./documents
CONFIG_PATH=./config
AUDIT_PATH=./audit

# Retrieval
CHILD_CHUNK_SIZE=400
CHILD_CHUNK_OVERLAP=50
PARENT_CHUNK_SIZE=2000
PARENT_CHUNK_OVERLAP=200
RETRIEVER_TOP_K=10
RERANK_TOP_K=4
BM25_WEIGHT=0.4
VECTOR_WEIGHT=0.6
ENABLE_RERANKER=true
ENABLE_QUERY_REWRITE=true

# Cache
CACHE_ENABLED=true
CACHE_TTL_SECONDS=3600
CACHE_MAX_SIZE=1000

# Rate limit
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_BURST=10

# API
API_HOST=0.0.0.0
API_PORT=8000
API_CORS_ORIGINS=http://localhost:3000
API_MAX_REQUEST_SIZE_MB=10
SECURITY_HEADERS_ENABLED=true
FORCE_HTTPS=false

# Audit
AUDIT_ENABLED=true
AUDIT_MAX_PAYLOAD_CHARS=500

# Metrics
METRICS_ENABLED=true
