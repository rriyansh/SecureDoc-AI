# SecureDoc AI Environment Variables

# Application
APP_NAME=secure-doc-ai
APP_ENV=development
LOG_LEVEL=info

# API
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4

# OpenAI / LLM
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0.1
OPENAI_MAX_TOKENS=1024

# Vector Store (Qdrant)
VECTORSTORE_PROVIDER=qdrant
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=secure_docs
VECTOR_DIM=1536

# Document Store
DOCSTORE_PATH=./docstore

# Embeddings
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_BATCH_SIZE=100

# Chunking
CHUNK_SIZE=512
CHUNK_OVERLAP=50

# Retrieval
TOP_K=5
RERANK_TOP_K=25
HYBRID_ALPHA=0.5

# Evaluation
EVAL_DATASET_PATH=./tests/eval_dataset.json
RAGAS_METRICS=faithfulness,answer_relevancy,context_precision,context_recall

# NeMo Guardrails
GUARDRAILS_CONFIG_PATH=./config/rails
INPUT_RAILS_ENABLED=true
OUTPUT_RAILS_ENABLED=true
